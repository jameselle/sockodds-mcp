{
  "name": "sockodds-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.jameselle/sockodds-mcp",
  "description": "MCP server that lets Claude answer 'what are the odds on X right now' with the SockOdds sports odds API.",
  "license": "MIT",
  "homepage": "https://github.com/jameselle/sockodds-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jameselle/sockodds-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jameselle/sockodds-mcp/issues"
  },
  "type": "module",
  "bin": {
    "sockodds-mcp": "dist/src/index.js"
  },
  "main": "dist/src/index.js",
  "files": [
    "dist/src",
    "fixtures",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "sports-odds",
    "odds-api",
    "afl",
    "nrl",
    "sockodds"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.0"
  }
}
